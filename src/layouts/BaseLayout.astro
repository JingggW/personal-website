---
import '../styles/global.css';
import { absoluteUrl, site } from '../lib/site';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; publishedTime?: Date; }
const { title = site.title, description = site.description, image = '/og-default.svg', type = 'website', publishedTime } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const schema = type === 'article' ? undefined : { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebSite', name: site.name, url: site.url, description: site.description }, { '@type': 'Person', name: site.name, url: site.url, jobTitle: 'Independent consultant' }] };
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="robots" content="index, follow" /><link rel="canonical" href={canonical} /><link rel="sitemap" href="/sitemap-index.xml" /><link rel="alternate" type="application/rss+xml" title={`${site.name} writing`} href="/rss.xml" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title><meta property="og:site_name" content={site.name} /><meta property="og:type" content={type} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={absoluteUrl(image)} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={absoluteUrl(image)} />{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}</head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><a class="wordmark" href="/" aria-label="Jingwei home">JW<span>·</span></a><nav aria-label="Primary navigation"><a href="/projects/">Projects</a><a href="/writing/">Writing</a><a href="/about/">About</a></nav><a class="contact-link" href={`mailto:${site.email}`}>Let’s talk <span aria-hidden="true">↗</span></a></header><main id="main"><slot /></main><footer class="site-footer"><p>Independent research &amp; technical practice.</p><p><a href={site.social.github}>GitHub</a><span> / </span><a href={site.social.linkedin}>LinkedIn</a><span> / </span><a href="/rss.xml">RSS</a></p></footer></body></html>
